<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.camila.core</groupId>
    <artifactId>camila-services</artifactId>
    <version>1.0.0</version>
  </parent>

  <groupId>com.camila.testing</groupId>
  <artifactId>camila-coverage-jacoco</artifactId>
  <name>camila-coverage-jacoco</name>
  <description>Camila Coverage Jacoco</description>

  <dependencies>
    <dependency>
      <groupId>com.camila.admin</groupId>
      <artifactId>camila-admin</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.camila.config</groupId>
      <artifactId>camila-config</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.camila.discovery</groupId>
      <artifactId>camila-discovery</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.camila.gateway</groupId>
      <artifactId>camila-gateway</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.camila.api</groupId>
      <artifactId>camila-product-api-domain</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.camila.api</groupId>
      <artifactId>camila-product-api-application</artifactId>
      <version>1.0.0</version>
    </dependency>
    <!-- Infrastructure modules for coverage -->
    <dependency>
      <groupId>com.camila.api</groupId>
      <artifactId>camila-product-api-infrastructure-boot</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.camila.api</groupId>
      <artifactId>camila-product-api-infrastructure-rest</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.camila.api</groupId>
      <artifactId>camila-product-api-infrastructure-graphql</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.camila.api</groupId>
      <artifactId>camila-product-api-infrastructure-grpc</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.camila.api</groupId>
      <artifactId>camila-product-api-infrastructure-websocket</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.camila.api</groupId>
      <artifactId>camila-product-api-infrastructure-rsocket</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.camila.api</groupId>
      <artifactId>camila-product-api-infrastructure-security</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.camila.api</groupId>
      <artifactId>camila-product-api-infrastructure-mongo</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.camila.api</groupId>
      <artifactId>camila-product-api-infrastructure-couchbase</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.camila.api</groupId>
      <artifactId>camila-product-api-infrastructure-cache</artifactId>
      <version>1.0.0</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>jacoco-site-aggregate</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
