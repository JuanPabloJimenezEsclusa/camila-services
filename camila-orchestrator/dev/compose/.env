# common
SPRING_PROFILES_ACTIVE="dev"
JVM_OPTIONS="-Xms256m -Xmx1024m"
JAVA_TOOL_OPTIONS=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005 -Dcom.sun.management.jmxremote.ssl=false -Dcom.sun.management.jmxremote.authenticate=false -Dcom.sun.management.jmxremote.port=5000 -Dcom.sun.management.jmxremote.rmi.port=5000 -Dcom.sun.management.jmxremote.host=0.0.0.0 -Djava.rmi.server.hostname=0.0.0.0
JAVA_OPTS="-XX:+UseContainerSupport --enable-native-access=ALL-UNNAMED -Djava.security.egd=file:/dev/./urandom"
EUREKA_URI="http://discovery:8761/eureka"

# config
CONFIG_SERVER_URI="http://config:8888"

# discovery

# gateway
GATEWAY_SERVER_URL="http://gateway"
PRODUCT_SERVER_URL="lb://CAMILA-PRODUCT-API"

# mongodb
MONGODB_INITDB_ROOT_USERNAME=camila
MONGODB_INITDB_ROOT_PASSWORD=camila
GLIBC_TUNABLES="glibc.pthread.rseq=0"

# couchbase
CLUSTER_NAME=camila-couchbase-cluster
COUCHBASE_USERNAME=Administrator
COUCHBASE_PASSWORD=password
COUCHBASE_BUCKET=camila-product-bucket
COUCHBASE_BUCKET_SCOPE=product
COUCHBASE_BUCKET_COLLECTION=products
COUCHBASE_BUCKET_RAMSIZE=2048
COUCHBASE_RAM_SIZE=2048
COUCHBASE_INDEX_RAM_SIZE=1024

# redis
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=camila

# redis-insight
RI_REDIS_HOST_0=redis
RI_REDIS_PORT_0=6379
RI_REDIS_ALIAS_0=REDIS_LOCAL
RI_REDIS_USERNAME_0=default
RI_REDIS_PASSWORD_0=camila

# backend-product
spring.mongodb.uri="mongodb://camilauser:camilauser@mongodb:27017/camila-db?maxPoolSize=200&connectTimeoutMS=120000&timeoutMS=120000&serverSelectionTimeoutMS=90000"
spring.couchbase.connection-string="couchbase"
spring.couchbase.username="Administrator"
spring.couchbase.password="password"
spring.couchbase.env.ssl.enabled="false"
LANG="en_US.utf8"
LANGUAGE="en_US.utf8"
LC_ALL="en_US.utf8"
TIME_ZONE=UTC
REPOSITORY_TECHNOLOGY=mongo

## OpenTelemetry Configuration
OTEL_SDK_DISABLED=false
OTEL_TRACES_EXPORTER=zipkin
OTEL_METRICS_EXPORTER=prometheus
OTEL_EXPORTER_ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans
OTEL_EXPORTER_ZIPKIN_TIMEOUT=30000
OTEL_EXPORTER_ZIPKIN_MAX_PAYLOAD_SIZE_BYTES=512000
OTEL_SERVICE_NAMESPACE=camila
OTEL_RESOURCE_ATTRIBUTES=service.version=1.0.0,environment=dev
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://zipkin:4317

## gRPC Configuration
SPRING_GRPC_SERVER_PORT=6565
SPRING_GRPC_SERVER_KEEP_ALIVE_TIME=30s
SPRING_GRPC_SERVER_KEEP_ALIVE_TIMEOUT=10s
SPRING_GRPC_SERVER_KEEP_ALIVE_PERMIT_WITHOUT_CALLS=false
SPRING_GRPC_SERVER_MAX_INBOUND_MESSAGE_SIZE=16777216B
SPRING_GRPC_SERVER_REFLECTION_ENABLED=true
SPRING_GRPC_SERVER_HEALTH_ENABLED=true

# admin

# prometheus

# grafana
GF_INSTALL_PLUGINS=grafana-clock-panel

# keycloak
KC_HEALTH_ENABLED=true
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin1234
KC_HOSTNAME_STRICT=false
KC_HTTP_ENABLED=true
KEYCLOAK_LOGLEVEL=DEBUG
KEYCLOAK_URL="http://keycloak:9191"
KEYCLOAK_REALM="camila-realm"

# zipkin
ZIPKIN_TRACING_ENDPOINT="http://zipkin:9411/api/v2/spans"

# elasticsearch
discovery.type=single-node
xpack.security.enabled=false
cluster.name=elasticsearch
bootstrap.memory_lock=true
ES_JAVA_OPTS="-Xms512m -Xmx1000m"

# fluentd
FLUENT_ELASTICSEARCH_HOST=elasticsearch
FLUENT_ELASTICSEARCH_PORT=9200

# kibana
ELASTICSEARCH_HOSTS=http://elasticsearch:9200
