            <stringProp name="Argument.value">${__P(OAUTH_PATH,/realms/camila-realm/protocol/openid-connect/token)}</stringProp>
            <stringProp name="Argument.desc">/realms/camila-realm/protocol/openid-connect/token | /oauth2/token</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
