        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="RandomParameters" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import java.text.DecimalFormat;

DecimalFormat df = new DecimalFormat(&quot;0.0000&quot;);

double rand1 = Math.random();
double rand2 = Math.random();
double rand3 = Math.random();
double rand4 = Math.random();

double sumaTotal = rand1 + rand2 + rand3 + rand4;

double var1 = rand1 / sumaTotal;
double var2 = rand2 / sumaTotal;
double var3 = rand3 / sumaTotal;
double var4 = rand4 / sumaTotal;

vars.put(&quot;random_sales_units&quot;, df.format(var1));
vars.put(&quot;random_stock&quot;, df.format(var2));
vars.put(&quot;random_profit_margin&quot;, df.format(var3));
vars.put(&quot;random_days_in_stock&quot;, df.format(var4));
</stringProp>
            <stringProp name="scriptLanguage">java</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <RandomOrderController guiclass="RandomOrderControllerGui" testclass="RandomOrderController" testname="Random Order Controller" enabled="true"/>
