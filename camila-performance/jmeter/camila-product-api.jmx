          </elementProp>
          <elementProp name="OAUTH_URL_PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">OAUTH_URL_PROTOCOL</stringProp>
            <stringProp name="Argument.value">${__P(OAUTH_URL_PROTOCOL,http)}</stringProp>
            <stringProp name="Argument.desc">http | https</stringProp>
